# Lead Radar environment. Copy to .env (untracked) and fill only what you have.
# Never commit real credentials. Names here are the single source of truth.

# --- Application -----------------------------------------------------------
APP_ENV=development                 # development | production
APP_HOST=0.0.0.0
APP_PORT=8080
DATABASE_URL=sqlite://data/lead-radar.db?mode=rwc
LOG_LEVEL=info
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
# Development-only bearer token used by the dashboard server and curl.
# In production (APP_ENV=production) API tokens must exist in the database.
DEV_API_TOKEN=dev-local-token
CORS_ALLOWED_ORIGINS=http://localhost:4321
RETENTION_DAYS=180

# --- Provider selection (explicit; there is no silent fallback) ------------
# jev | mock          (mock is deterministic, offline, never billed)
DECISION_PROVIDER=jev
# qwen | mock
GENERATIVE_PROVIDER=qwen
# apify | manual | mock
SOURCE_PROVIDER=apify

# --- Apify -----------------------------------------------------------------
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com
APIFY_MAX_CONCURRENT_RUNS=2
APIFY_MAX_ITEMS_PER_RUN=50
APIFY_MAX_RUN_COST=0.50
APIFY_DAILY_BUDGET=2.00
APIFY_TOTAL_BUDGET=25.00
APIFY_KILL_SWITCH=false
APIFY_RUN_TIMEOUT_SECONDS=900
APIFY_POLL_INTERVAL=15

# --- Jev (structured decisions) -------------------------------------------
# Two documented deployments, non-interchangeable keys and model ids:
#   jev-ai.org         key sk-glm5-…   JEV_BASE_URL=https://jev-ai.org          JEV_API_PATH=/api/v1/systemone/   JEV_MODEL=jev-1.13
#   api.typesafe.ai    key apikey_…    JEV_BASE_URL=https://api.typesafe.ai     JEV_API_PATH=/v1/systemone        JEV_MODEL=jev-1.14.0
JEV_API_KEY=
JEV_BASE_URL=https://jev-ai.org
JEV_API_PATH=/api/v1/systemone/
JEV_MODEL=jev-1.13
JEV_TIMEOUT=30

# --- Laya (benchmark-only second decision provider) ------------------------
LAYA_ENABLED=false
LAYA_API_KEY=
LAYA_BASE_URL=https://api.laya.studio
LAYA_MODEL=
LAYA_TIMEOUT=30

# --- Qwen (generative, OpenAI-compatible endpoint) -------------------------
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_TIMEOUT=60
QWEN_MAX_TOKENS=1200

# --- Worker ----------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_AI_CONCURRENCY=2
WORKER_POLL_INTERVAL=2
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BACKOFF=5
JOB_LEASE_SECONDS=120

# --- Frontend (Astro SSR) --------------------------------------------------
FRONTEND_PORT=4321
PUBLIC_API_BASE_URL=http://localhost:8080
API_INTERNAL_URL=http://api:8080
LEAD_RADAR_API_TOKEN=dev-local-token
