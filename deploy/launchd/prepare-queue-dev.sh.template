#!/usr/bin/env bash
# Generated by scripts/install-cron.sh — do not edit; reinstall instead.
#
# macOS launchd cannot read the project's external volume (TCC: "Operation not permitted"), so this
# runner lives in ~/Library/Application Support/lead-radar and keeps its two inputs in
# ~/.config/lead-radar: the API base URL and the token (mode 0600). Nothing here prints the token.
set -euo pipefail

CONFIG_DIR="${HOME}/.config/lead-radar"
LOG_FILE="${HOME}/Library/Logs/lead-radar/prepare-queue.log"
LIMIT="${PREPARE_LIMIT:-3}"

API_BASE="$(cat "${CONFIG_DIR}/api-base" 2>/dev/null || echo 'http://localhost:8080')"
API_TOKEN="$(cat "${CONFIG_DIR}/api-token" 2>/dev/null || true)"
mkdir -p "$(dirname "$LOG_FILE")"

if [ -z "$API_TOKEN" ]; then
  printf '%s no token at %s/api-token\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$CONFIG_DIR" >>"$LOG_FILE"
  exit 3
fi

response_file="$(mktemp)"
trap 'rm -f "$response_file"' EXIT
status="$(curl -sS --max-time 30 -o "$response_file" -w '%{http_code}' \
  -X POST "${API_BASE%/}/api/v1/reply-console/prepare" \
  -H "Authorization: Bearer ${API_TOKEN}" \
  -H 'Content-Type: application/json' \
  -d "{\"limit\":${LIMIT},\"auto\":true}" || echo 000)"
body="$(cat "$response_file")"

if [ -f "$LOG_FILE" ] && [ "$(wc -c <"$LOG_FILE")" -gt 1048576 ]; then
  mv "$LOG_FILE" "$LOG_FILE.1"
fi
printf '%s status=%s body=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$status" "$body" >>"$LOG_FILE"

if [ "$status" != "202" ] && [ "$status" != "200" ]; then
  echo "prepare-queue: HTTP ${status}" >&2
  exit 1
fi
